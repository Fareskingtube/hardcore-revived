    "homepage": "https://github.com/Fareskingtube/hardcore-revived",
    "sources": "https://github.com/Fareskingtube/hardcore-revived"
  },
  "license": "LGPL-2.1",
  "icon": "assets/hardcore-revived/icon.png",
