{
  "schemaVersion": 1,
  "id": "hardcore-revived",
  "version": "${version}",
  "name": "Hardcore Revived",
  "description": "This is a mod that tries to enhance the multiplayer hardcore experience",
  "authors": [
    {
      "name": "Fareskingtube",
      "contact": {
        "homepage": "https://github.com/Fareskingtube"
      }
    }
  ],
